{
  "name": "riskpilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.4.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:service": "pnpm --filter @riskpilot/service dev",
    "dev:web": "pnpm --filter @riskpilot/web dev",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "preflight": "pnpm --filter @riskpilot/service preflight"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
