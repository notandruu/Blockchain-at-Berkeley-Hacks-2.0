# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SERVICE_URL=http://localhost:4000

# Server only
CONTEXT_DEV_API_KEY=
GEMINI_API_KEY=
GEMINI_API_SECRET=
# master keys: account in the group to trade from, and time-based if the key was created that way
GEMINI_ACCOUNT=
GEMINI_NONCE_MODE=monotonic
GEMINI_ENV=sandbox
ANTHROPIC_API_KEY=
AGENT_MODEL=
# only for keys not scoped to a workspace (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DATABASE_URL=
CONTEXT_WEBHOOK_SECRET=
SERVICE_PORT=4000
WEB_ORIGIN=http://localhost:3100
DEMO_MODE=true
ALLOW_PRODUCTION_TRADING=false

# Budgets (application policy, not provider settings)
RESEARCH_CREDIT_CEILING=40
QUOTE_MAX_AGE_MS=5000

# Local demo operator, created by `pnpm --filter @beagle/service seed`
DEMO_USER_EMAIL=operator@beagle.test
DEMO_USER_PASSWORD=
DEMO_MERCHANT_NAME=Golden Bear Taproom
